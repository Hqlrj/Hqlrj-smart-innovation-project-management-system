<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springbootproject.mapper.ProjectPlanMapper">

    <!-- 结果映射：将数据库字段映射到Java对象属性 -->
    <resultMap id="projectPlanResultMap" type="org.example.springbootproject.pojo.ProjectPlan">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="filePath" column="file_path"/>
        <result property="fileName" column="file_name"/>
        <result property="fileSize" column="file_size"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 根据项目ID查询计划书列表 -->
    <select id="listByProjectId" resultMap="projectPlanResultMap">
        SELECT id, project_id, file_path, file_name, file_size, create_time, update_time
        FROM project_plan
        WHERE project_id = #{projectId}
        ORDER BY create_time ASC
    </select>

    <!-- 根据ID查询计划书 -->
    <select id="getById" resultMap="projectPlanResultMap">
        SELECT id, project_id, file_path, file_name, file_size, create_time, update_time
        FROM project_plan
        WHERE id = #{id}
    </select>

    <!-- 新增计划书 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO project_plan (project_id, file_path, file_name, file_size, create_time)
        VALUES (#{projectId}, #{filePath}, #{fileName}, #{fileSize}, #{createTime})
    </insert>

    <!-- 批量新增计划书 -->
    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO project_plan (project_id, file_path, file_name, file_size, create_time)
        VALUES
        <foreach collection="plans" item="plan" separator=",">
            (#{plan.projectId}, #{plan.filePath}, #{plan.fileName}, #{plan.fileSize}, #{plan.createTime})
        </foreach>
    </insert>

    <!-- 删除计划书 -->
    <delete id="delete">
        DELETE FROM project_plan WHERE id = #{id}
    </delete>

    <!-- 根据项目ID删除所有计划书 -->
    <delete id="deleteByProjectId">
        DELETE FROM project_plan WHERE project_id = #{projectId}
    </delete>

</mapper>

